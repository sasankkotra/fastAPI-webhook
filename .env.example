# Local development only. Never commit .env or credentials.
# Cloud Run injects these two values from pinned GCP Secret Manager versions.
# Generate with: openssl rand -hex 256
# Required format: 512 hex characters encoding 256 random bytes (2048 bits).
# Both receiver and sender MUST hex-decode this value before HMAC signing.
WEBHOOK_SECRET=replace-with-512-hexadecimal-characters-from-openssl-rand-hex-256
DB_PASSWORD=replace-with-existing-database-user-password

# Local Cloud SQL Auth Proxy: cloud-sql-proxy --port 5432 PROJECT:REGION:INSTANCE
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=replace-with-existing-database-name
DB_USER=replace-with-existing-database-user
# Disable TLS only for the local proxy or Cloud Run's /cloudsql Unix socket.
# For direct TCP to a database use verify-full with a trusted server CA.
DB_SSLMODE=disable

# Cloud Run: DB_HOST=/cloudsql/gen-lang-client-0786534718:REGION:INSTANCE
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
SIGNATURE_TOLERANCE_SECONDS=300
MAX_REQUEST_BYTES=1048576
